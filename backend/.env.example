# ==============================================================================
# Smart Manufacturing Backend Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# Automatically falls back to local SQLite (backend/smart_manufacturing.db) if MySQL is unreachable.
# ------------------------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=smart_manufacturing

# ------------------------------------------------------------------------------
# 2. Blockchain & Smart Contract Configuration (Web3.py)
# ------------------------------------------------------------------------------
# Local Ganache / Hardhat node RPC: http://127.0.0.1:8545
# For Sepolia Testnet, use: https://sepolia.infura.io/v3/<YOUR_INFURA_KEY>
BLOCKCHAIN_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/alch_tJuaoSi-nP15N5dOK1F99

# SmartManufacturing.sol deployed contract address
CONTRACT_ADDRESS=0xceF405C02983F243D66F7d04adD3AD1f287c00f3

# Ethereum private key for server-side automated transaction signing
# (Default Ganache Account #0 private key for local development)
ETHEREUM_PRIVATE_KEY=28b30430132b8908251212158131f0f05ad4f354a08cf080aa0201a01f83a959

# ------------------------------------------------------------------------------
# 3. REST API Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
FLASK_ENV=development
